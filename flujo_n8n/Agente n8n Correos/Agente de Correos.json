      "parameters": {
        "jsCode": "// Llamamos directamente al nodo Codigo por nombre — sin depender del input\nconst datos = $('Codigo').first().json;\n\nconst respuesta = datos.respuesta || 'No se generó una respuesta.';\nconst seccion   = datos.seccion_aplicada || 'Información General';\nconst tipo      = datos.tipo || 'Soporte';\n\n// Ticket ID y Fecha\nconst ticketId = 'TQ-' + Date.now().toString(36).toUpperCase();\nconst fecha = new Date().toLocaleDateString('es-CO', { \n  day: '2-digit', \n  month: 'long', \n  year: 'numeric', \n  timeZone: 'America/Bogota' \n});\n\nconst html = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #2c2c2c;\">\n  <div style=\"background: #1a1a2e; padding: 20px 24px; border-radius: 8px 8px 0 0;\">\n    <span style=\"color: #ffffff; font-size: 20px; font-weight: bold; letter-spacing: 1px;\">TAQUION</span>\n    <span style=\"color: #a0a8c0; font-size: 12px; margin-left: 8px;\">Fast Service</span>\n  </div>\n  <div style=\"border: 1px solid #e0e0e0; border-top: none; padding: 28px 24px; border-radius: 0 0 8px 8px;\">\n    <p style=\"color: #555; font-size: 13px; margin: 0 0 16px;\">Ticket: <strong>${ticketId}</strong> · ${fecha}</p>\n    <p style=\"font-size: 16px; line-height: 1.7; color: #2c2c2c; margin: 0 0 20px;\">${respuesta}</p>\n    <div style=\"background: #f5f7fa; border-left: 3px solid #4a6fa5; padding: 12px 16px; border-radius: 0 6px 6px 0; margin: 0 0 24px;\">\n      <p style=\"font-size: 12px; color: #666; margin: 0;\">Referencia política aplicada: <strong>${seccion}</strong></p>\n    </div>\n    <hr style=\"border: none; border-top: 1px solid #eee; margin: 0 0 20px;\">\n    <p style=\"font-size: 12px; color: #888; margin: 0;\">\n      Soporte: <a href=\"mailto:taquionsystem@gmail.com\" style=\"color: #4a6fa5;\">taquionsystem@gmail.com</a> \n      · WhatsApp: <a href=\"https://wa.me/573117676493\" style=\"color: #4a6fa5;\">311 767 6493</a>\n      · Instagram: <a href=\"https://instagram.com/Taquion_Saas\" style=\"color: #4a6fa5;\">@Taquion_Saas</a>\n    </p>\n    <p style=\"font-size: 11px; color: #bbb; margin: 8px 0 0;\">Este correo fue generado automáticamente para los procesos de ${tipo}.</p>\n  </div>\n</div>`;\n\nreturn { \n  json: {\n    html_final: html, \n    ticket_id: ticketId,\n    destinatario: datos.remitente || 'usuario@ejemplo.com'\n  }\n};"
      },

      "parameters": {
        "jsCode": "try {\n  const input = $input.first().json;\n  \n  // RAMA CACHÉ: la respuesta ya viene como objeto parseado\n  if (input.cache_hit === true && input.respuesta && typeof input.respuesta === 'object') {\n    const r = input.respuesta;\n    return [{\n      json: {\n        tipo:             r.tipo             || 'consulta',\n        prioridad:        r.prioridad        || 'media',\n        confianza:        r.confianza        || 'baja',\n        seccion_aplicada: r.seccion_aplicada || '',\n        respuesta:        r.respuesta_sugerida || r.respuesta || '',\n        escalar:          r.escalar          || false,\n        razon:            r.razon_escalado   || '',\n        remitente:        $('Gmail Trigger').first().json.From || '',\n        desde_cache:      true\n      }\n    }];\n  }\n\n  // RAMA AI AGENT: parsea el output del modelo\n  const raw = input.output ?? '{}';\n  const texto = typeof raw === 'object' ? JSON.stringify(raw) : raw;\n  const match = texto.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error('No JSON found in: ' + texto.substring(0, 100));\n\n  const limpio = match[0]\n    .replace(/\\\\'/g, \"'\")\n    .replace(/\\t/g, ' ')\n    .replace(/[\\u0000-\\u001F\\u007F]/g, ' ')\n    .replace(/\\n/g, '\\\\n');\n\n  let json;\n  try {\n    json = JSON.parse(limpio);\n  } catch(e2) {\n    json = {\n      tipo:             (texto.match(/\"tipo\"\\s*:\\s*\"([^\"]+)\"/) || [])[1] || 'consulta',\n      prioridad:        (texto.match(/\"prioridad\"\\s*:\\s*\"([^\"]+)\"/) || [])[1] || 'media',\n      confianza:        (texto.match(/\"confianza\"\\s*:\\s*\"([^\"]+)\"/) || [])[1] || 'baja',\n      seccion_aplicada: (texto.match(/\"seccion_aplicada\"\\s*:\\s*\"([^\"]+)\"/) || [])[1] || '',\n      respuesta_sugerida:(texto.match(/\"respuesta_sugerida\"\\s*:\\s*\"([\\s\\S]+?)\"(?:\\s*,|\\s*\\})/) || [])[1] || '',\n      escalar:          texto.includes('\"escalar\": true') || texto.includes('\"escalar\":true'),\n      razon_escalado:   (texto.match(/\"razon_escalado\"\\s*:\\s*\"([^\"]*)\"/) || [])[1] || ''\n    };\n  }\n\n  return [{\n    json: {\n      tipo:             json.tipo             || 'consulta',\n      prioridad:        json.prioridad        || 'media',\n      confianza:        json.confianza        || 'baja',\n      seccion_aplicada: json.seccion_aplicada || '',\n      respuesta:        json.respuesta_sugerida || '',\n      escalar:          json.escalar          || false,\n      razon:            json.razon_escalado   || '',\n      remitente:        $('Gmail Trigger').first().json.From || '',\n      desde_cache:      false\n    }\n  }];\n\n} catch(e) {\n  return [{\n    json: {\n      tipo:             'error',\n      prioridad:        'alta',\n      confianza:        'baja',\n      seccion_aplicada: '',\n      respuesta:        '',\n      escalar:          true,\n      razon:            'Error al procesar respuesta: ' + e.message,\n      remitente:        $('Gmail Trigger').first().json.From || '',\n      desde_cache:      false\n    }\n  }];\n}"
      },

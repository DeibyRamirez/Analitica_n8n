    {
      "parameters": {
        "jsCode": "const resultado = $input.first().json;\nconst embedding = $('Generar Embedding').first().json.embedding;\nconst texto = $('Webhook').first().json.body.texto;\nconst accion = $('Webhook').first().json.body.accion; // 'consultar' o 'guardar'\n\n// Si viene a guardar, no evalúa hit/miss\nif (accion === 'guardar') {\n  return {\n    json: {\n      accion: 'guardar',\n      embedding: embedding,\n      texto: texto,\n      respuesta: $('Webhook').first().json.body.respuesta,\n      tipo: $('Webhook').first().json.body.tipo,\n      seccion: $('Webhook').first().json.body.seccion\n    }\n  };\n}\n\n// Si viene a consultar, evalúa el resultado\nif (resultado && Array.isArray(resultado) && resultado.length > 0) {\n  return {\n    json: {\n      accion: 'consultar',\n      cache_hit: true,\n      similitud: resultado[0].similitud,\n      cache_id: resultado[0].cache_id,\n      respuesta: resultado[0].respuesta,\n      embedding: embedding,\n      texto: texto\n    }\n  };\n}\n\nreturn {\n  json: {\n    accion: 'consultar',\n    cache_hit: false,\n    similitud: 0,\n    cache_id: null,\n    respuesta: null,\n    embedding: embedding,\n    texto: texto\n  }\n};"
      },

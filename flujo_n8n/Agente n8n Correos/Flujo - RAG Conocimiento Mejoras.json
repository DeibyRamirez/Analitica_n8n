    {
      "parameters": {
        "jsCode": "// Nodo de confirmacion: muestra cuantos chunks se indexaron\nconst items = $input.all();\nconst ahora = new Date().toLocaleString('es-CO', { timeZone: 'America/Bogota' });\n\nconsole.log(`[RAG Ingesta] Indexacion completada a las ${ahora}`);\nconsole.log(`[RAG Ingesta] Items procesados: ${items.length}`);\n\nreturn [{\n  json: {\n    status: 'OK',\n    mensaje: `Documento indexado exitosamente`,\n    timestamp: ahora,\n    chunks_indexados: items.length\n  }\n}];"
      },

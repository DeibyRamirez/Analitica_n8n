    {
      "parameters": {
        "jsCode": "// Limpia el texto y prepara metadata para cada chunk\nconst texto = $input.first().json.texto_documento || '';\n\n// Elimina lineas vacias multiples y espacios extra\nconst textoLimpio = texto\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nconst ahora = new Date().toISOString();\n\nreturn [{\n  json: {\n    texto_limpio: textoLimpio,\n    longitud_caracteres: textoLimpio.length,\n    fecha_indexacion: ahora,\n    nombre_documento: 'TERMINOS_DEVOLUCION_PEDIDO_ENTREGA'\n  }\n}];"
      },
      "id": "847b0bc8-18fa-47c3-a102-18991520440c",
